{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": "container",
  "data": {
    "values": []
  },
  "params": [
    {
      "name": "bawTitleSize",
      "value": 20
    },
    {
      "name": "bawFontSize",
      "value": 14
    }
  ],
  "config": {
    "legend": {
      "title": null,
      "labelFontSize": {
        "expr": "bawFontSize"
      },
      "orient": "top"
    }
  },
  "resolve": {
    "legend": {
      "color": "independent"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "interpolate": "linear",
        "color": "var(--baw-primary)",
        "opacity": 0.2
      },
      "encoding": {
        "x": {
          "field": "range[0]",
          "type": "temporal"
        },
        "y": {
          "field": "cumulativeUniqueTagCount",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "interpolate": "linear",
        "color": "var(--baw-primary)"
      },
      "encoding": {
        "x": {
          "field": "range[0]",
          "type": "temporal",
          "axis": {
            "title": null,
            "format": {
              "year": "%Y",
              "quarter": "%Y-%m",
              "month": "%Y-%m",
              "week": "%Y-%m-%d",
              "date": "%Y-%m-%d",
              "day": "%Y-%m-%d",
              "hours": "%Y-%m-%d %H:%M",
              "minutes": "%Y-%m-%d %H:%M:%S",
              "seconds": "%Y-%m-%d %H:%M:%S",
              "milliseconds": "%Y-%m-%d %H:%M:%S.%L"
            },
            "labelAngle": -30,
            "labelAlign": "right",
            "labelFlush": true,
            "labelFlushOffset": 4,
            "tickSize": 4,
            "tickWidth": 1,
            "gridWidth": 0.5,
            "labelPadding": 4,
            "labelFontSize": {
              "expr": "bawFontSize"
            }
          }
        },
        "y": {
          "title": "Count of Tags",
          "field": "cumulativeUniqueTagCount",
          "type": "quantitative",
          "axis": {
            "titleFontSize": {
              "expr": "bawTitleSize"
            },
            "labelFontSize": {
              "expr": "bawFontSize"
            }
          }
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "color": "black"
      },
      "encoding": {
        "x": {
          "title": "Date",
          "field": "range[0]",
          "type": "temporal"
        },
        "y": {
          "title": "Count of Tags",
          "field": "cumulativeUniqueTagCount",
          "type": "quantitative"
        },
        "color": {
          "field": "datum",
          "legend": {
            "values": [
              "Count of Tags"
            ],
            "symbolType": "stroke",
            "symbolStrokeColor": "var(--baw-primary)",
            "symbolStrokeWidth": 4
          }
        },
        "tooltip": [
          {
            "field": "range[0]",
            "type": "temporal",
            "title": "From",
            "format": "%Y-%m-%d %H:%M:%S.%L %Z"
          },
          {
            "field": "range[1]",
            "type": "temporal",
            "title": "To",
            "format": "%Y-%m-%d %H:%M:%S.%L %Z"
          },
          {
            "field": "cumulativeUniqueTagCount",
            "type": "quantitative",
            "title": "Count of Tags"
          }
        ]
      }
    }
  ]
}
