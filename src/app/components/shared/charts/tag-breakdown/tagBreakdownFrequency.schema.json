{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": "container",
  "data": {
    "values": []
  },
  "params": [
    {
      "name": "bawTitleSize",
      "value": 14
    },
    {
      "name": "bawFontSize",
      "value": 11
    }
  ],
  "config": {
    "customFormatTypes": true,
    "axis": {
      "titleFontSize": {
        "expr": "bawTitleSize"
      },
      "labelFontSize": {
        "expr": "bawFontSize"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "interpolate": "linear",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "range[0]",
          "title": "Date",
          "type": "temporal",
          "axis": {
            "format": {
              "year": "%Y",
              "quarter": "%Y-%m",
              "month": "%Y-%m",
              "week": "%Y-%m-%d",
              "date": "%Y-%m-%d",
              "day": "%Y-%m-%d",
              "hours": "%Y-%m-%d %H:%M",
              "minutes": "%Y-%m-%d %H:%M:%S",
              "seconds": "%Y-%m-%d %H:%M:%S",
              "milliseconds": "%Y-%m-%d %H:%M:%S.%L"
            },
            "labelAngle": -30,
            "labelAlign": "right",
            "labelFlush": true,
            "labelFlushOffset": 4
          },
          "scale": {
            "padding": 0
          }
        },
        "y": {
          "title": "Count",
          "field": "events",
          "type": "quantitative"
        },
        "color": {
          "field": "color",
          "type": "nominal",
          "scale": null,
          "legend": null
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 48
      },
      "encoding": {
        "x": {
          "field": "range[0]",
          "type": "temporal"
        },
        "y": {
          "field": "events",
          "type": "quantitative"
        },
        "color": {
          "field": "color",
          "type": "nominal",
          "scale": null,
          "legend": null
        },
        "tooltip": [
          {
            "type": "temporal",
            "field": "range[0]",
            "title": "From",
            "format": "%Y-%m-%d %H:%M:%S.%L %Z"
          },
          {
            "type": "temporal",
            "field": "range[1]",
            "title": "To",
            "format": "%Y-%m-%d %H:%M:%S.%L %Z"
          },
          {
            "field": "events",
            "title": "Count"
          }
        ]
      }
    }
  ]
}
