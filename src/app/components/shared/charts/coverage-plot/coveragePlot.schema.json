{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "datasets": {},
  "data": {
    "name": "coverage"
  },
  "params": [
    {
      "name": "bawFontSize",
      "value": 14
    }
  ],
  "config": {
    "facet": {
      "spacing": 12
    },
    "header": {
      "labelFontSize": {
        "expr": "bawFontSize"
      }
    },
    "style": {
      "cell": {
        "stroke": "transparent"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.coverageType === 'Recordings' ? 4.4 : datum.coverageType === 'success' ? 3.3 : datum.coverageType === 'failed' ? 2.2 : datum.coverageType === 'killed' ? 1.1 : 0",
      "as": "slotBottom"
    },
    {
      "calculate": "datum.coverageType === 'Recordings' ? 2 : 1",
      "as": "slotHeight"
    },
    {
      "calculate": "datum.slotBottom + datum.density * datum.slotHeight",
      "as": "barTop"
    }
  ],
  "facet": {
    "row": {
      "field": "siteName",
      "type": "nominal",
      "sort": {
        "field": "siteId",
        "op": "min"
      },
      "header": {
        "title": null,
        "labelAngle": 0,
        "labelAlign": "right",
        "labelBaseline": "middle",
        "labelPadding": 8
      }
    }
  },
  "spec": {
    "width": "container",
    "height": 60,
    "mark": "bar",
    "encoding": {
      "x": {
        "field": "range[0]",
        "type": "temporal",
        "axis": {
          "title": null,
          "grid": true,
          "format": {
            "year": "%Y",
            "quarter": "%Y-%m",
            "month": "%Y-%m",
            "week": "%Y-%m-%d",
            "date": "%Y-%m-%d",
            "day": "%Y-%m-%d",
            "hours": "%Y-%m-%d %H:%M",
            "minutes": "%Y-%m-%d %H:%M:%S",
            "seconds": "%Y-%m-%d %H:%M:%S",
            "milliseconds": "%Y-%m-%d %H:%M:%S.%L"
          },
          "labelAngle": -30,
          "labelAlign": "right",
          "labelFlush": true,
          "labelFlushOffset": 4,
          "tickSize": 4,
          "tickWidth": 1,
          "gridWidth": 0.5,
          "labelPadding": 4,
          "labelFontSize": {
            "expr": "bawFontSize"
          }
        }
      },
      "x2": {
        "field": "range[1]"
      },
      "y": {
        "field": "barTop",
        "type": "quantitative",
        "scale": {
          "nice": false
        },
        "axis": null
      },
      "y2": {
        "field": "slotBottom"
      },
      "color": {
        "field": "coverageType",
        "type": "nominal",
        "scale": {
          "domain": [
            "Recordings",
            "success",
            "failed",
            "killed",
            "cancelled"
          ],
          "range": [
            "var(--baw-primary)",
            "var(--baw-success)",
            "var(--baw-danger)",
            "var(--baw-warning)",
            "var(--baw-secondary)"
          ]
        },
        "legend": {
          "title": null,
          "orient": "top",
          "direction": "horizontal",
          "columns": 5,
          "symbolType": "square",
          "labelFontSize": {
            "expr": "bawFontSize"
          },
          "labelExpr": "datum.label === 'Recordings' ? datum.label : upper(substring(datum.label, 0, 1)) + substring(datum.label, 1)"
        }
      },
      "tooltip": [
        {
          "field": "siteName",
          "type": "nominal",
          "title": "Site"
        },
        {
          "field": "coverageType",
          "type": "nominal",
          "title": "Coverage"
        },
        {
          "field": "density",
          "type": "quantitative",
          "title": "Density",
          "format": ".1%"
        },
        {
          "field": "range[0]",
          "type": "temporal",
          "title": "Start Date",
          "format": "%Y-%m-%d %H:%M:%S.%L %Z"
        },
        {
          "field": "range[1]",
          "type": "temporal",
          "title": "End Date",
          "format": "%Y-%m-%d %H:%M:%S.%L %Z"
        }
      ]
    }
  },
  "resolve": {
    "scale": {
      "x": "shared",
      "y": "shared"
    }
  }
}
